# Copy names only. Real values live in ../.env (outside the repo) for local dev,
# and in Render's environment for production. Never commit real values.

# FalkorDB (local dev uses FalkorDB Cloud; production uses the embedded server on 127.0.0.1)
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_PREFIX=dev_ll

# LLM providers (the LLM only chooses tools and phrases answers)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Data and actions
MBTA_API_KEY=
GITHUB_TOKEN=
OPS_REPO=murthyroshan/lastlift-ops

# App behaviour
APP_ENV=development
LLM_MODE=replay
ACTIONS_MODE=draft
LIVE_FEED=off
ALLOWED_ORIGINS=http://localhost:5173
LIVE_DAILY_LLM_CAP=150
