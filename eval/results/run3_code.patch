diff --git a/lastlift/agent/replay.py b/lastlift/agent/replay.py
index ff63e95..51d0ab9 100644
--- a/lastlift/agent/replay.py
+++ b/lastlift/agent/replay.py
@@ -4,6 +4,11 @@ A replay stores every event of one run. Each tool_result carries a digest of the
 volatile parts removed (timings, what-if copy names, the via stamp). Verifying a replay re-executes every
 recorded tool call through the MCP server on the same scope and compares digests: no drift = the graph
 still gives exactly the recorded answers. The LLM's wording is not re-run; only the facts it was given.
+
+Every replay is also hash-chained: chain[i] = sha256(chain[i-1] + canonical JSON of event i), and `head` is the last
+link. Editing any byte of any event breaks the chain from that event on. The canonical JSON (sorted keys, no spaces,
+integral floats written as integers) is the one a browser's JSON.stringify produces, so the website can check a
+replay itself ("Verify this replay").
 """
 import hashlib
 import json
@@ -31,12 +36,56 @@ def digest(env: dict) -> str:
     return hashlib.sha256(json.dumps(canonical(env), sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:16]
 
 
+def jscanon(x) -> str:
+    """Canonical JSON, identical to the website's canon() (web/src/components/AgentDrawer.tsx)."""
+    def norm(v):
+        if isinstance(v, dict):
+            return {k: norm(v[k]) for k in sorted(v)}
+        if isinstance(v, list):
+            return [norm(i) for i in v]
+        if isinstance(v, float) and v.is_integer():
+            return int(v)
+        return v
+    return json.dumps(norm(x), separators=(",", ":"), ensure_ascii=False)
+
+
+def chain(events) -> list[str]:
+    h, out = "", []
+    for e in events:
+        h = hashlib.sha256((h + jscanon(e)).encode("utf-8")).hexdigest()
+        out.append(h)
+    return out
+
+
+def seal(rec: dict) -> dict:
+    rec["chain"] = chain(rec["events"])
+    rec["head"] = rec["chain"][-1] if rec["chain"] else ""
+    return rec
+
+
+def chain_problems(rec: dict) -> list[str]:
+    """Empty when the replay's events still hash to its recorded chain."""
+    got = chain(rec.get("events", []))
+    want = rec.get("chain") or []
+    if not want:
+        return [f"{rec.get('id')}: not sealed (no hash chain)"]
+    for i, (a, b) in enumerate(zip(got, want)):
+        if a != b:
+            return [f"{rec.get('id')}: hash chain broken at event {i + 1}"]
+    if len(got) != len(want) or rec.get("head") != (want[-1] if want else ""):
+        return [f"{rec.get('id')}: hash chain length or head does not match"]
+    return []
+
+
 def load(replay_id: str) -> dict:
     return json.loads((REPLAY_DIR / f"{replay_id}.json").read_text(encoding="utf-8"))
 
 
 async def verify(rec: dict, mcp) -> list[str]:
-    """Re-execute a replay's tool calls; return the list of drifts (empty = verified)."""
+    """Check the hash chain, then re-execute the tool calls; return the list of drifts (empty = verified)."""
+    broken = chain_problems(rec)
+    if broken:
+        return broken
     scope = next(e["scope"] for e in rec["events"] if e["type"] == "start")
     calls = [e for e in rec["events"] if e["type"] == "tool_call"]
     results = [e for e in rec["events"] if e["type"] == "tool_result"]
diff --git a/lastlift/agents/__init__.py b/lastlift/agents/__init__.py
new file mode 100644
index 0000000..4d96ed1
--- /dev/null
+++ b/lastlift/agents/__init__.py
@@ -0,0 +1,11 @@
+"""Operations agents: three roles in one process, with no language model in the critical path.
+
+  Monitor     reads the scope's lift closures (the alert feed);
+  Analyst     chooses a playbook from graph facts (Cypher), calls the tools through MCP, writes an Assessment;
+  Dispatcher  proposes actions from a fixed policy table, only for assessments made at the graph's current
+              state_version (a Cypher guard); a stale belief cannot act. Humans approve; nothing is filed here.
+
+Roles hand off by writing nodes ((:Assessment)-[:ABOUT]->(:Lift), (:ActionProposal)-[:BASED_ON]->(:Assessment)),
+so every decision can be read back in Cypher. No language model is given a write tool, so text in an alert (or a
+prompt injection in it) cannot cause an action.
+"""
diff --git a/lastlift/agents/notify.py b/lastlift/agents/notify.py
new file mode 100644
index 0000000..be54cfd
--- /dev/null
+++ b/lastlift/agents/notify.py
@@ -0,0 +1,91 @@
+"""Rider notices through ntfy ("Follow a station"): one notice when a station loses or regains step-free access in
+the open-data model, none when nothing changed. LastLift stores nothing about subscribers: following is a
+subscription in the rider's own ntfy app to a public topic.
+
+Topic: lastlift-<salt>-<station slug>. Off unless NOTIFY_MODE=ntfy (the default is a dry run that returns the
+notice). Dedupe: the station's last notice hash is kept on its Station node; an identical state sends nothing, and
+two notices of the same kind are at least MIN_GAP_S apart.
+"""
+import hashlib
+import os
+import re
+import time
+
+import httpx
+
+from .. import db, state
+from ..wording import NEVER_SAY
+
+SALT = os.environ.get("NOTIFY_SALT", "ll7c3a91")
+MIN_GAP_S = 30 * 60
+NTFY = "https://ntfy.sh"
+SITE = os.environ.get("PUBLIC_SITE", "https://lastlift.vercel.app")
+
+
+def topic(station_id: str) -> str:
+    slug = re.sub(r"[^a-z0-9]+", "-", station_id.lower()).strip("-")
+    return f"lastlift-{SALT}-{slug}"
+
+
+def subscribe_url(station_id: str) -> str:
+    return f"{NTFY}/{topic(station_id)}"
+
+
+def compose(station_name: str, lost: list[dict], lifts: list[str]) -> dict:
+    """lost: [{"platform": name, "dir": board|exit}] (empty = access restored)."""
+    if lost:
+        what = "; ".join(f"{x['platform']} ({'getting on' if x['dir'] == 'board' else 'getting off'})" for x in lost)
+        body = (f"{station_name}: no step-free route in the open-data model for {what} while elevator "
+                f"{', '.join(lifts)} is out. Check mbta.com/alerts/access before travelling.")
+        return {"kind": "loss", "title": f"{station_name}: step-free access lost", "body": body, "priority": "4"}
+    body = (f"{station_name}: step-free access is back in the open-data model (elevator {', '.join(lifts)} back in "
+            "service per MBTA's feed). Check mbta.com/alerts/access before travelling.")
+    return {"kind": "restore", "title": f"{station_name}: step-free access restored", "body": body, "priority": "3"}
+
+
+def lint(text: str) -> list[str]:
+    return [p for p in NEVER_SAY if re.search(p, text, re.I)]
+
+
+Q_LAST = "MATCH (s:Station {uid:$sid}) RETURN s.notice_hash, s.notice_kind, s.notice_at, s.name, s.notice_lifts"
+Q_SET = ("MATCH (s:Station {uid:$sid}) SET s.notice_hash = $h, s.notice_kind = $k, s.notice_at = $t, "
+         "s.notice_lifts = $l")
+Q_OPEN_LOSSES = "MATCH (s:Station) WHERE s.notice_kind = 'loss' RETURN s.uid, s.notice_lifts"
+
+
+def open_losses(scope: str) -> dict:
+    g = db.client().select_graph(state.graph_name(scope))
+    return {sid: list(lifts or []) for sid, lifts in g.ro_query(Q_OPEN_LOSSES).result_set}
+
+
+def publish(scope: str, station_id: str, lost: list[dict], lifts: list[str], transport=None, now=None) -> dict:
+    """Send (or dry-run) one notice if the station's state changed. Returns what happened."""
+    g = db.client().select_graph(state.graph_name(scope))
+    rs = g.ro_query(Q_LAST, {"sid": station_id}).result_set
+    last_hash, last_kind, last_at, name, last_lifts = rs[0] if rs else (None, None, None, station_id, [])
+    lifts = lifts or list(last_lifts or [])
+    if not lost and last_kind != "loss":
+        return {"sent": False, "reason": "nothing to restore"}
+    msg = compose(name or station_id, lost, lifts)
+    h = hashlib.sha256((msg["kind"] + msg["body"]).encode()).hexdigest()[:16]
+    now = now if now is not None else time.time()
+    if h == last_hash:
+        return {"sent": False, "reason": "no change"}
+    if last_kind == msg["kind"] and last_at and now - last_at < MIN_GAP_S:
+        return {"sent": False, "reason": "rate limited"}
+    problems = lint(msg["body"] + " " + msg["title"])
+    if problems:
+        return {"sent": False, "reason": f"wording: {problems}"}
+    mode = os.environ.get("NOTIFY_MODE", "off")
+    headers = {"Title": msg["title"], "Tags": "wheelchair", "Priority": msg["priority"],
+               "Click": f"{SITE}/#/station/{station_id}"}
+    if transport is not None or mode == "ntfy":
+        post = transport or (lambda url, **kw: httpx.post(url, timeout=10, **kw))
+        r = post(f"{NTFY}/{topic(station_id)}", content=msg["body"].encode(), headers=headers)
+        if getattr(r, "status_code", 200) >= 300:
+            return {"sent": False, "reason": f"ntfy HTTP {r.status_code}"}
+        sent = True
+    else:
+        sent = False                                    # dry run: the notice is returned, not posted
+    g.query(Q_SET, {"sid": station_id, "h": h, "k": msg["kind"], "t": now, "l": lifts})
+    return {"sent": sent, "dry_run": not sent, "topic": topic(station_id), **msg}
diff --git a/lastlift/agents/roles.py b/lastlift/agents/roles.py
new file mode 100644
index 0000000..fa81b63
--- /dev/null
+++ b/lastlift/agents/roles.py
@@ -0,0 +1,288 @@
+"""Monitor, Analyst and Dispatcher (see lastlift/agents/__init__.py), and tick() which runs them in order."""
+import hashlib
+import time
+import uuid
+
+from fastmcp import Client
+
+from .. import alerts, db, state, tools
+from ..config import settings
+from ..mcp_server import mcp
+
+CHRONIC_QUANTILE = 0.75   # +CHRONIC: the lift is in the top quarter of modelled lifts by closures in the archive's
+                          # last 12 months (computed from the graph on every tick)
+
+# Action policy table (printed in the README). Nothing is filed by this module: approved tickets are drafts until
+# the ticket executor (GitHub) runs; rider notices are dry runs unless a notifier is configured.
+POLICY = {
+    "repair_ticket": {"approval": "human", "for": ("ACCESS_LOST",)},
+    "protect_ticket": {"approval": "human", "for": ("PREVENTIVE",)},
+    "rider_notice": {"approval": "auto", "for": ("ACCESS_LOST",)},
+}
+
+Q_LIFT_FACTS = (
+    "MATCH (l:Lift) WHERE l.facility_id = $fid WITH l ORDER BY l.uid LIMIT 1 "
+    "OPTIONAL MATCH (s:Station {uid:l.station_id}) "
+    "RETURN l.uid, (l:Node) AS modelled, l.cx, l.station_id, coalesce(s.has_pathways, false), l.outages_12m"
+)
+Q_ACCESS_LOST_BY = (
+    "MATCH (p:Node:Platform {cx:$cx}) WHERE (p.k_board = 0 AND p.k_board_base > 0 AND $fid IN p.cut_board) "
+    "OR (p.k_exit = 0 AND p.k_exit_base > 0 AND $fid IN p.cut_exit) "
+    "RETURN DISTINCT p.stop_id, p.name, p.platform_name, p.k_board_base, p.k_board, p.k_exit_base, p.k_exit, "
+    "$fid IN p.cut_board AND p.k_board = 0, $fid IN p.cut_exit AND p.k_exit = 0 ORDER BY p.stop_id"
+)
+Q_NEW_LAST_AT = (
+    "MATCH (p:Node:Platform {cx:$cx})-[n:DEPENDS_NOW]->(l:Lift) WHERE NOT (p)-[:DEPENDS_ON {dir:n.dir}]->(l) "
+    "RETURN l.facility_id, collect(DISTINCT p.stop_id + ' ' + n.dir) ORDER BY l.facility_id"
+)
+Q_META_VERSION = "MATCH (m:Meta) RETURN m.state_version LIMIT 1"
+Q_GUARD = "MATCH (a:Assessment {aid:$aid}) MATCH (m:Meta) WHERE a.state_version = m.state_version RETURN count(a)"
+Q_SUPERSEDE = (
+    "MATCH (p:ActionProposal)-[:BASED_ON]->(a:Assessment) MATCH (m:Meta) "
+    "WHERE p.status = 'proposed' AND a.state_version <> m.state_version SET p.status = 'superseded' RETURN count(p)"
+)
+Q_WRITE_ASSESSMENT = (
+    "MERGE (a:Assessment {aid:$aid}) SET a += $p WITH a "
+    "MATCH (l:Lift {uid:$lift}) MERGE (a)-[:ABOUT]->(l)"
+)
+Q_WRITE_FINDS = (
+    "MATCH (a:Assessment {aid:$aid}) UNWIND $rows AS r MATCH (p:Node:Platform) WHERE p.stop_id = r.stop "
+    "MERGE (a)-[f:FINDS {dir:r.dir}]->(p) SET f.k_before = r.kb, f.k_after = r.ka"
+)
+Q_WRITE_PROPOSAL = (
+    "MATCH (a:Assessment {aid:$aid}) MERGE (p:ActionProposal {pid:$pid}) "
+    "ON CREATE SET p += $p, p.created_at = $now MERGE (p)-[:BASED_ON]->(a) RETURN p.status"
+)
+
+
+def _now():
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+
+
+class Trace:
+    """Events for one tick, in the agent event format (with the role in `agent` and W3C-style span ids)."""
+
+    def __init__(self, scope):
+        self.events, self.trace_id, self.scope = [], uuid.uuid4().hex, scope
+
+    def emit(self, agent, event, **payload):
+        ev = {"agent": agent, "type": event, "span_id": uuid.uuid4().hex[:16], "trace_id": self.trace_id, **payload}
+        self.events.append(ev)
+        return ev
+
+
+def monitor(scope, trace):
+    """The scope's lift closures: one item per (alert, facility)."""
+    items = []
+    for c in alerts.closures_for(scope):
+        for fid in c["facility_ids"]:
+            items.append({"facility_id": fid, "alert_id": c["alert_id"], "header": c.get("header")})
+            trace.emit("monitor", "incident", facility_id=fid, alert_id=c["alert_id"])
+    return items
+
+
+def chronic_threshold(scope) -> int:
+    g = db.client().select_graph(state.graph_name(scope))
+    v = sorted(r[0] or 0 for r in g.ro_query(
+        "MATCH (l:Node:Lift) WITH l.facility_id AS f, max(l.outages_12m) AS n RETURN n").result_set)
+    return v[int(CHRONIC_QUANTILE * len(v))] if v else 10 ** 9
+
+
+async def analyse(item, scope, trace, client, chronic_min=None):
+    """Choose the playbook from graph facts, run its tools through MCP, write the Assessment."""
+    graph = state.graph_name(scope)
+    g = db.client().select_graph(graph)
+    fid = item["facility_id"]
+    version = (g.ro_query(Q_META_VERSION).result_set or [[None]])[0][0]
+    facts = g.ro_query(Q_LIFT_FACTS, {"fid": fid}).result_set
+    uid, modelled, cx, station, has_paths, outages = facts[0] if facts else (None, False, None, None, False, None)
+    chronic = bool(outages and chronic_min is not None and outages >= chronic_min)
+    calls = []
+
+    async def call(name, args):
+        res = await client.call_tool(name, {**args, **({"scope": scope} if name != "resolve_place" else {})},
+                                     raise_on_error=False)
+        env = res.structured_content or {}
+        calls.append({"tool": name, "ok": env.get("ok"), "summary": env.get("summary")})
+        trace.emit("analyst", "tool_result", tool=name, via="mcp", ok=env.get("ok"), summary=env.get("summary"))
+        return env
+
+    finds, targets = [], []
+    if not uid or not modelled or not has_paths:
+        playbook, verdict = "ABSTAIN", "CANNOT_ASSESS"
+        await call("resolve_place", {"query": fid})
+    else:
+        stranded = g.ro_query(Q_ACCESS_LOST_BY, {"cx": cx, "fid": fid}).result_set
+        new_last = g.ro_query(Q_NEW_LAST_AT, {"cx": cx}).result_set
+        if stranded:
+            playbook, verdict = "ACCESS_LOST", "LOSS"
+            await call("platform_redundancy", {"station_id": station})
+            for stop, _n, _pn, kbb, kb, keb, ke, lost_b, lost_e in stranded:
+                label = " ".join(x for x in (_pn, _n) if x)
+                if lost_b:
+                    finds.append({"stop": stop, "dir": "board", "kb": kbb, "ka": kb, "name": label})
+                    await call("step_free_route", {"from_station": station, "to_platform": stop})
+                if lost_e:
+                    finds.append({"stop": stop, "dir": "exit", "kb": keb, "ka": ke, "name": label})
+                    await call("step_free_route", {"from_station": station, "from_platform": stop})
+            await call("draft_action", {"facility_id": fid})
+        elif new_last:
+            playbook, verdict = "PREVENTIVE", "LAST_LIFT"
+            targets = [r[0] for r in new_last]
+            for t in targets:                       # re-check: closing the last lift too must cut access
+                await call("what_if_close", {"facility_ids": [t]})
+            await call("repair_priority", {})
+        else:
+            playbook, verdict = "NO_LOSS", "NO_LOSS"
+            await call("platform_redundancy", {"station_id": station})
+    aid = hashlib.sha1(f"{scope}|{fid}|{version}|{playbook}".encode()).hexdigest()[:16]
+    props = {"run_id": trace.trace_id, "facility_id": fid, "station_id": station or "", "state_version": version,
+             "playbook": playbook,
+             "verdict": verdict, "chronic": chronic, "targets": targets, "alert_id": item["alert_id"],
+             "created_at": _now(), "tools": [c["tool"] for c in calls]}
+    if uid:
+        g.query(Q_WRITE_ASSESSMENT, {"aid": aid, "p": props, "lift": uid})
+        if finds:
+            g.query(Q_WRITE_FINDS, {"aid": aid, "rows": [{k: f[k] for k in ("stop", "dir", "kb", "ka")} for f in finds]})
+    trace.emit("analyst", "assessment", aid=aid, facility_id=fid, playbook=playbook, verdict=verdict,
+               chronic=chronic, targets=targets, state_version=version)
+    return {"aid": aid if uid else None, **props, "finds": finds}
+
+
+def dispatch(assessment, scope, trace):
+    """Proposals from the policy table, guarded by the current state_version. Returns the proposals made."""
+    g = db.client().select_graph(state.graph_name(scope))
+    g.query(Q_SUPERSEDE)
+    aid = assessment.get("aid")
+    if not aid or not g.ro_query(Q_GUARD, {"aid": aid}).result_set[0][0]:
+        trace.emit("dispatcher", "guard", aid=aid, ok=False)
+        return []
+    trace.emit("dispatcher", "guard", aid=aid, ok=True)
+    made = []
+    fid, playbook = assessment["facility_id"], assessment["playbook"]
+    for kind, rule in POLICY.items():
+        if playbook not in rule["for"]:
+            continue
+        for target in (assessment["targets"] or [fid]) if kind == "protect_ticket" else [fid]:
+            priority = "priority-1" if playbook == "ACCESS_LOST" or assessment["chronic"] else "priority-2"
+            idem = f"lift-{target}:{playbook}:{kind}:{assessment['state_version']}"
+            pid = hashlib.sha1(idem.encode()).hexdigest()[:16]
+            status = "proposed" if rule["approval"] == "human" else "dry_run"
+            res = g.query(Q_WRITE_PROPOSAL, {"aid": aid, "pid": pid, "now": _now(), "p": {
+                "kind": kind, "status": status, "policy": rule["approval"], "idem_key": idem, "facility_id": target,
+                "about": fid, "playbook": playbook, "label": priority, "scope": scope,
+                "mode": settings.actions_mode}}).result_set
+            made.append({"pid": pid, "kind": kind, "facility_id": target, "status": res[0][0] if res else status,
+                         "label": priority})
+            trace.emit("dispatcher", "proposal", pid=pid, kind=kind, facility_id=target, label=priority,
+                       status=res[0][0] if res else status)
+    return made
+
+
+def notices(scope, assessments, trace, transport=None):
+    """Rider notices (policy: auto): a loss notice per station with stranded platforms, a restore notice for a station
+    whose last notice was a loss and which now has none."""
+    from . import notify
+    lost = {}
+    for a in assessments:
+        if a["playbook"] == "ACCESS_LOST" and a.get("station_id"):
+            x = lost.setdefault(a["station_id"], {"lost": [], "lifts": []})
+            x["lost"] += [{"platform": f["name"], "dir": f["dir"]} for f in a["finds"]]
+            x["lifts"].append(a["facility_id"])
+    out = []
+    for sid, x in sorted(lost.items()):
+        r = notify.publish(scope, sid, x["lost"], sorted(set(x["lifts"])), transport)
+        out.append({"station_id": sid, **r})
+        trace.emit("dispatcher", "rider_notice", station_id=sid, sent=r.get("sent"), reason=r.get("reason"),
+                   kind=r.get("kind"))
+    for sid, lifts in sorted(notify.open_losses(scope).items()):
+        if sid not in lost:
+            r = notify.publish(scope, sid, [], lifts, transport)
+            out.append({"station_id": sid, **r})
