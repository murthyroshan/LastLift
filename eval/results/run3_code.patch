+        parts.append(f"{a['closures']} closures in the archive since {a['from']}")
+    if mem["assessments"]:
+        last = mem["assessments"][0]
+        parts.append(f"last assessed {last['at']} as {last['playbook']} ({last['verdict']})")
+    if mem["proposals"]:
